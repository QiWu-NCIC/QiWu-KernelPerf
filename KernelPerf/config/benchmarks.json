[
  {
    "benchmark_id": "spmv",
    "display_name": "Managed CSR SpMV",
    "driver": "benchmarks.spmv.driver:SpmvBenchmark",
    "template": "benchmarks/spmv/template.cu",
    "public": true,
    "default": true,
    "default_dataset_id": "suitesparse_sample_100",
    "operators": [
      {
        "op_id": "spmv.csr.fp32",
        "name": "CSR SpMV FP32",
        "dtype": "fp32",
        "problem_kind": "spmv",
        "flops_formula": "2 * nnz",
        "metadata": {
          "requires_matrix": true,
          "input_format": "csr",
          "format": "candidate-defined",
          "driver_config": {
            "warmup": 5,
            "iterations": 20,
            "validation_safety_factor": 4.0,
            "algorithm": "candidate-defined"
          },
          "contract": "preprocess/solve/destroy plugin interface"
        }
      },
      {
        "op_id": "spmv.csr.fp64",
        "name": "CSR SpMV FP64",
        "dtype": "fp64",
        "problem_kind": "spmv",
        "flops_formula": "2 * nnz",
        "metadata": {
          "requires_matrix": true,
          "input_format": "csr",
          "format": "candidate-defined",
          "driver_config": {
            "warmup": 5,
            "iterations": 20,
            "validation_safety_factor": 4.0,
            "algorithm": "candidate-defined"
          },
          "contract": "preprocess/solve/destroy plugin interface"
        }
      }
    ],
    "options": {
      "driver_id": "spmv-lifecycle",
      "contract": "include/qiwu/spmv_plugin.cuh",
      "language": "cuda",
      "entrypoint": "qiwu_spmv_plugin",
      "source_limit_bytes": 33554432,
      "max_source_files": 4096,
      "object_limit_bytes": 16000000,
      "compiler": "nvcc",
      "compile_options": ["-O3", "-std=c++17"],
      "link_options": ["-lcusparse"],
      "compile_timeout_seconds": 180,
      "run_timeout_seconds": 1200,
      "build_root": "data/build/spmv",
      "validation_method": "cpu-csr-reference-dynamic-row-bound"
    }
  },
